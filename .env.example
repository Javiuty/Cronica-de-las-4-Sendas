# Copia este archivo a `.env` (docker compose lo lee solo) y rellénalo.
# Vale para desarrollo (docker-compose.yml) y para el VPS (docker-compose.prod.yml).

# ---- Base de datos ----------------------------------------------------------
POSTGRES_USER=cronica
POSTGRES_PASSWORD=cronica
POSTGRES_DB=cronica
# Solo en desarrollo: en el VPS la base no publica puerto.
POSTGRES_PORT=5432

# ---- Backend ----------------------------------------------------------------
# Obligatorio: firma las sesiones. Genera uno con `openssl rand -hex 32`.
# Si cambia, todas las sesiones abiertas caducan.
JWT_SECRETO=

# La clave del cronista. Vive solo aquí: ya no viaja al navegador.
ANTHROPIC_API_KEY=

# Opcional: modelo del cronista (por defecto claude-opus-5).
# CLAUDE_MODELO=claude-opus-5

# ---- Frenos contra el abuso -------------------------------------------------
# Techo de gasto: encrucijadas por día en todo el servidor. Es el único límite
# que se cumple pase lo que pase (vive en la base, no en memoria). A ~0,05-0,13 $
# la encrucijada, 500 son unos 27-63 $ al día en el peor caso.
TOPE_DIARIO_CRONISTA=500
# Por jugador y minuto.
TOPE_CRONISTA_POR_USUARIO=30
# Por IP: cuentas nuevas por hora, e intentos de entrar cada cinco minutos.
TOPE_REGISTROS_POR_IP=5
TOPE_LOGINS_POR_IP=20

# ---- Puertos ----------------------------------------------------------------
# Desarrollo: el juego en 5173 y la API en 8000.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Producción: puerto local para mirar desde el propio VPS (no sale a internet).
# La cara pública la sirve Nginx Proxy Manager.
PUERTO_WEB=8080

# Red de Docker que comparten NPM y este juego. Créala con:
#   docker network create proxy
RED_PROXY=proxy

# ---- CORS -------------------------------------------------------------------
# Solo hace falta si el frontend vive en otro dominio que el backend. Con
# docker compose comparten origen y esto se puede dejar vacío.
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173
