# Copia este archivo a `.env.local` y rellena la clave para jugar en local.
# La clave viaja al navegador: úsala solo en desarrollo. Para publicar el juego,
# sustituye `completar` en src/juego/cronista.js por una llamada a tu backend.
VITE_ANTHROPIC_API_KEY=

# Opcional: modelo del cronista (por defecto claude-opus-5).
# VITE_CLAUDE_MODEL=claude-opus-5
