# Normalmente no hace falta: el cliente pide a `/api`, del mismo origen, y lo
# reenvía Vite en desarrollo y nginx en producción.

# Solo si arrancas el backend en otro puerto que el 8000:
# VITE_PROXY_DESTINO=http://localhost:9000

# Solo si el backend vive en otro dominio (entonces hay que configurar
# ORIGENES_PERMITIDOS en el backend):
# VITE_API_URL=https://api.tudominio.com/api
